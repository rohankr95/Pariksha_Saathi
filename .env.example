# ── Database ────────────────────────────────────────────────────────────
# Any Postgres works: Supabase, Neon, RDS, or self-hosted on the VPS.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/pariksha_saathi?schema=public"

# Only used by docker-compose.yml's `db` service (self-hosted Postgres
# container) — docker-compose builds the app's DATABASE_URL from these
# automatically, so you don't need to edit the URL above when deploying
# with Docker. Not used for a managed Postgres (Supabase/Neon/RDS).
POSTGRES_USER="pariksha"
POSTGRES_PASSWORD="replace-with-a-strong-password"
POSTGRES_DB="pariksha_saathi"

# ── Auth (Auth.js / NextAuth) ──────────────────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-string"
# Public site URL (used for absolute links in emails, .ics files, etc.)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── File storage ────────────────────────────────────────────────────────
# STORAGE_DRIVER = "local" | "s3"
STORAGE_DRIVER="local"
# Used only when STORAGE_DRIVER=local
LOCAL_UPLOAD_DIR="./uploads"
# Used only when STORAGE_DRIVER=s3 (Supabase Storage / Cloudflare R2 / AWS S3 — all S3-compatible)
S3_ENDPOINT=""
S3_REGION="auto"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_BASE_URL=""

# ── Email ────────────────────────────────────────────────────────────────
# EMAIL_DRIVER = "smtp" | "resend"
EMAIL_DRIVER="smtp"
EMAIL_FROM="Pariksha Saathi <no-reply@surajpur.nic.in>"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
RESEND_API_KEY=""

# ── Scheduled jobs ───────────────────────────────────────────────────────
# Shared secret required by GET /api/cron/exam-reminders (as `Authorization:
# Bearer <secret>` or `?secret=`). Leave blank only for local development —
# the route runs unauthenticated if unset.
CRON_SECRET=""

# ── Misc ─────────────────────────────────────────────────────────────────
# District identity shown in header/footer — kept in env so it is not hard-coded.
NEXT_PUBLIC_DISTRICT_NAME="सूरजपुर"
NEXT_PUBLIC_HELPLINE_NUMBER="1800-XXX-XXXX"
NODE_ENV="development"
